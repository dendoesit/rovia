# FleetDeck — variabile de mediu, citite DOAR de backend (Netlify Functions).
# Frontend-ul nu are nevoie de nicio variabilă.
#
# Producție: Netlify → Site configuration → Environment variables,
#            apoi Deploys → Trigger deploy ca să le prindă funcțiile.
# Local:     copiază fișierul ca `.env` (e ignorat de Git) și pornește
#            `npx netlify-cli dev --offline`.
#
# Toate sunt opționale: fără ele aplicația merge, doar că funcțiile
# respective (e-mailuri, scanare AI) apar ca neconfigurate.

# ---------- E-mailuri (remindere zilnice, confirmarea adresei, resetarea parolei) ----------
# Cheie de la https://resend.com (planul gratuit ajunge pentru remindere).
# Fără ea: nu se trimit remindere, iar „Am uitat parola” răspunde că nu e configurat.
RESEND_API_KEY=

# Expeditorul, ex: FleetDeck <remindere@firma-ta.ro>
# Domeniul trebuie VERIFICAT în Resend (Domains → Add domain, apoi recordurile DNS).
# Implicit se folosește FleetDeck <onboarding@resend.dev>, care trimite DOAR către
# adresa proprietarului contului Resend — bun pentru test, nu pentru utilizatori reali.
REMINDER_FROM=

# ---------- Scanarea documentelor cu AI (📷 în fluxurile de document) ----------
# Varianta gratuită, recomandată: cheie Gemini de la https://aistudio.google.com (fără card).
# Aplicația limitează oricum la 60 de citiri AI pe zi pentru fiecare cont.
GEMINI_API_KEY=
# Opțional — modelul Gemini (implicit gemini-3.5-flash)
GEMINI_MODEL=

# Alternativă cu plată, folosită doar dacă GEMINI_API_KEY lipsește: https://platform.openai.com
OPENAI_API_KEY=
# Opțional — modelul OpenAI (implicit gpt-4o-mini)
OPENAI_MODEL=
